# Copy this file to `.env.tauri-signing.local` and fill in your local signing secrets.
# This file is safe to commit; `.env.tauri-signing.local` is gitignored.

# Preferred: point to the private key file on your machine.
TAURI_SIGNING_PRIVATE_KEY_PATH=/absolute/path/to/pi-session-manager.key

# Optional: password for the private key.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Alternative to *_PATH: inline the key content directly.
# TAURI_SIGNING_PRIVATE_KEY=
