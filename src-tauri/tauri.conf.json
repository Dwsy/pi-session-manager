{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Pi Session Manager",
  "version": "0.5.2",
  "identifier": "com.pi.session-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwQURCNEM1Mzc2MzczQUYKUldTdmMyTTN4YlN0VUJsb3EyUm9LeHg3Wk1qQlJmVHpsbS96ZnRoY1p5cWs3dGUzTGJtNWZoZUEK",
      "endpoints": [
        "https://github.com/dwsy/pi-session-manager/releases/latest/download/updater.json"
      ],
      "dialog": true
    }
  }
}
