{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": false,
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/*"],
      "@pi-session-manager/plugin-sdk": ["packages/runtime-sdk/src"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
